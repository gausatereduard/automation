# Public keys generated in the secrets/ directory.
# Copy this file to .env and paste the real keys.

# secrets/jenkins_ssh_agent_key.pub — Jenkins controller -> ssh-agent
JENKINS_AGENT_SSH_PUBKEY="ssh-ed25519 AAAA... jenkins@controller"

# secrets/jenkins_ansible_agent_key.pub — Jenkins controller -> ansible-agent
ANSIBLE_AGENT_SSH_PUBKEY="ssh-ed25519 AAAA... jenkins@controller"

# secrets/ansible_test_server_key.pub — ansible-agent -> test-server (user ansible)
TEST_SERVER_ANSIBLE_PUBKEY="ssh-ed25519 AAAA... ansible@ansible-agent"
