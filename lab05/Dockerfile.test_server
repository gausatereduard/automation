FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# openssh-server is the only service baked into the image.
# Apache and PHP are installed later by the Ansible playbook, exactly as the
# assignment requires.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        openssh-server \
        python3 \
        python3-apt \
        rsync \
        sudo \
    && rm -rf /var/lib/apt/lists/*

# Ansible connects to the server as this user and uses passwordless sudo.
RUN useradd -m -u 1001 -s /bin/bash -d /home/ansible ansible \
    && usermod -aG sudo ansible \
    && printf 'ansible ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/ansible \
    && chmod 0440 /etc/sudoers.d/ansible

# Do not start services while packages are being installed; Ansible manages them.
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
    && chmod 0755 /usr/sbin/policy-rc.d

RUN mkdir -p /run/sshd /etc/ssh/sshd_config.d \
    && printf '%s\n' \
        'PasswordAuthentication no' \
        'PermitRootLogin no' \
        'PubkeyAuthentication yes' \
        'AllowUsers ansible' \
        > /etc/ssh/sshd_config.d/99-lab.conf

COPY docker/test_server_entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

EXPOSE 22 80

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
